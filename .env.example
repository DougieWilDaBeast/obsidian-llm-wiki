# Example environment for the wiki pipeline. Copy to `.env` and fill in.
#   cp .env.example .env
# The scripts read these (with sensible defaults); nothing here is secret except
# whatever your INGEST_CMD wrapper might use internally.

# --- Core ---------------------------------------------------------------------

# Absolute path to this repo / vault on the machine that runs the pipeline.
VAULT_ROOT=/home/you/obsidian-llm-wiki

# The model backend. Run as:  "$INGEST_CMD" "<abs raw path>"   (or  "$INGEST_CMD" LINT).
# UNSET => the ingest/lint scripts are a safe no-op (dormant). See SETUP.md Stage 2.
# Example: a wrapper around `claude -p`, an OpenAI/local-model call, or `copilot`.
# INGEST_CMD=/home/you/obsidian-llm-wiki/pipeline/ingest_backend.sh

# --- Voice transcription (Stage 3, optional) ----------------------------------

# Folder new phone voice clips land in (synced from the phone).
AUDIO_STAGING=/home/you/VoiceRecordings/Voice Recorder

# Path to the faster-whisper python venv's activate script.
WHISPER_VENV=/home/you/voice-pipeline/venv/bin/activate

# Where the sha256 transcription ledger lives (idempotency). Optional; has a default.
# WHISPER_LEDGER=/home/you/.local/state/llm-wiki/ledger.json

# --- Server / network (Stage 4, optional) -------------------------------------

# The server's address other devices reach it on (e.g. a Tailscale IP).
SERVER_IP=100.64.0.1

# The login user on that server (used by the n8n container->host ingest hop).
SERVER_USER=you

# --- n8n watcher (Stage 5b, optional) -----------------------------------------

# Host port to publish the n8n UI on.
N8N_PORT=5678

# Absolute path to the vault on the host, mounted read-only into the container.
VAULT_PATH=/home/you/obsidian-llm-wiki

# Your timezone for n8n schedules.
TZ=UTC
