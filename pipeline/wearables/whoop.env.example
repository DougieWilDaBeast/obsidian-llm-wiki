# WHOOP pipeline secrets — COPY to ~/whoop-pipeline/whoop.env and chmod 600.
# NEVER commit the real file. Values come from the WHOOP Developer Dashboard (your App).
WHOOP_CLIENT_ID=your-client-id-here
WHOOP_CLIENT_SECRET=your-client-secret-here
# Optional: override the token state file location (default ~/whoop-pipeline/state.json).
# WHOOP_STATE=/home/you/whoop-pipeline/state.json
